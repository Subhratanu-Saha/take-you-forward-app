# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/take_you_forward?sslmode=require"

# Environment
NODE_ENV=development
PORT=5000

# Email Service
EMAIL_USER_ID=your-email@example.com
EMAIL_USER_PASSCODE=your-app-password

# Authentication
JWT_SECRET=your-secure-jwt-secret-key
JWT_EXPIRES_IN=24h

# Slack Integration
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_ALLOWED_CHANNEL_ID=C0123456789
# Optional Slack Restrictions (leave empty if not restricting by workspace or individual users)
# SLACK_ALLOWED_TEAM_ID=T0123456789
# SLACK_ALLOWED_USER_IDS=U0123456789,U9876543210

# Render API Integration
RENDER_API_KEY=rnd_your_render_api_key_here
RENDER_OWNER_ID=tea-your_workspace_owner_id_here
RENDER_SERVICE_ID=srv-your_service_id_here
